{
  "name": "@getmikk/vscode-extension",
  "private": true,
  "displayName": "Mikk",
  "description": "Deterministic AI context engine for your codebase. See your architecture, detect dead code, and get precise AI context.",
  "version": "3.0.4",
  "license": "Apache-2.0",
  "publisher": "mikk-dev",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other", "Visualization"],
  "activationEvents": ["workspaceContains:mikk.json"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "mikk.init",        "title": "Mikk: Initialize" },
      { "command": "mikk.analyze",     "title": "Mikk: Analyze" },
      { "command": "mikk.showDiagram", "title": "Mikk: Show Architecture Diagram" },
      { "command": "mikk.showImpact",  "title": "Mikk: Show Impact Analysis" },
      { "command": "mikk.getContext",  "title": "Mikk: Get AI Context" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "mikk-explorer", "title": "Mikk", "icon": "resources/icon.svg" }
      ]
    },
    "views": {
      "mikk-explorer": [
        { "id": "mikkModules",   "name": "Modules",   "icon": "resources/icon.svg" },
        { "id": "mikkFunctions", "name": "Functions", "icon": "resources/icon.svg" },
        { "id": "mikkHealth",    "name": "Health",    "icon": "resources/icon.svg" }
      ]
    }
  },
  "repository": { "type": "git", "url": "https://github.com/Ansh-dhanani/mikk" },
  "scripts": {
    "build":   "node esbuild.mjs",
    "watch":   "node esbuild.mjs --watch",
    "package": "vsce package --no-dependencies",
    "deploy":  "vsce publish --no-dependencies",
    "lint":    "bunx eslint --config ../../eslint.config.mjs ."
  },
  "dependencies": {},
  "devDependencies": {
    "@getmikk/ai-context": "workspace:*",
    "@getmikk/core": "workspace:*",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.2",
    "typescript": "^5.7.0"
  }
}
