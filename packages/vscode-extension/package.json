{
    "name": "@getmikk/vscode-extension",
    "private": true,
    "displayName": "Mikk",
    "description": "Deterministic AI context engine for your codebase. See your architecture, detect dead code, and get precise AI context.",
    "version": "3.0.0",
    "license": "Apache-2.0",
    "publisher": "AnshDhanani",
    "icon": "resources/logo.png",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other",
        "Visualization"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "mikk.init",
                "title": "Mikk: Initialize",
                "icon": "$(zap)"
            },
            {
                "command": "mikk.analyze",
                "title": "Mikk: Analyze",
                "icon": "$(sync)"
            },
            {
                "command": "mikk.showDashboard",
                "title": "Mikk: Open Dashboard",
                "icon": "$(graph)"
            },
            {
                "command": "mikk.getContext",
                "title": "Mikk: Get AI Context",
                "icon": "$(hubot)"
            },
            {
                "command": "mikk.refreshAll",
                "title": "Mikk: Refresh",
                "icon": "$(refresh)"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "mikk-explorer",
                    "title": "Mikk",
                    "icon": "resources/logo.svg"
                }
            ]
        },
        "views": {
            "mikk-explorer": [
                {
                    "id": "mikkExplorer",
                    "name": "Mikk",
                    "icon": "resources/logo.svg"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "mikk.showDashboard",
                    "when": "view == mikkExplorer",
                    "group": "navigation@1"
                },
                {
                    "command": "mikk.refreshAll",
                    "when": "view == mikkExplorer",
                    "group": "navigation@2"
                }
            ]
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Ansh-dhanani/mikk"
    },
    "scripts": {
        "build": "node esbuild.mjs",
        "watch": "node esbuild.mjs --watch",
        "package": "vsce package --no-dependencies",
        "deploy": "vsce publish --no-dependencies",
        "lint": "eslint ."
    },
    "dependencies": {},
    "devDependencies": {
        "@getmikk/core": "workspace:*",
        "@getmikk/diagram-generator": "workspace:*",
        "@getmikk/ai-context": "workspace:*",
        "@types/vscode": "^1.85.0",
        "esbuild": "^0.27.3",
        "typescript": "^5.7.0"
    }
}
