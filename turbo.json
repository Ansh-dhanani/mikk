{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                ".next/**",
                "!.next/cache/**",
                "dist/**",
                "main.js",
                "manifest.json"
            ],
            "env": [
                "BUN_INSTALL_CACHE_DIR",
                "BUN_GLOBAL_DIR"
            ]
        },
        "test": {
            "dependsOn": [
                "^build"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "lint": {},
        "publish": {
            "dependsOn": [
                "build"
            ]
        }
    }
}